|--------------------------------------------------------------------------
| Laravel 11 Route Conversion Guide
|--------------------------------------------------------------------------
| Old Style: Route::get('path', 'ControllerName@method')
| New Style: Route::get('path', [ControllerName::class, 'method'])
|
| For Resource Routes:
| Old: Route::resource('path', 'Namespace\\ControllerName')
| New: Route::resource('path', Namespace\ControllerName::class)
|
| Note: Import all controllers at the top using:
| use App\Http\Controllers\Namespace\ControllerName;
*/

